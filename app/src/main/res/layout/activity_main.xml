<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp">
        <ScrollView
            android:id="@+id/scrollViewHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="100dp"
                android:clipToPadding="false">
                >

                <!-- Header (Tiêu đề và Nút Cài đặt) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="InsectID AI"
                            android:textColor="#2E7D32"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tìm kiếm và khám phá côn trùng"
                            android:textColor="#757575"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Nút Cài đặt -->
                    <ImageView
                        android:id="@+id/btnLogout"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/outline_settings_24"
                        android:padding="10dp"
                        app:tint="#2E7D32"
                        android:background="?attr/selectableItemBackgroundBorderless"/>
                </RelativeLayout>

                <!-- Danh mục: Nhóm côn trùng nổi bật -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nhóm côn trùng nổi bật"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>
                        />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:clipToPadding="false"
                    android:layout_marginTop="12dp"/>

                <!-- Côn trùng đáng chú ý -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Côn trùng đáng chú ý"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="24dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFeatured"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:clipToPadding="false"
                    android:layout_marginTop="12dp"/>

                <!-- Côn trùng quanh bạn (Khu vực) -->
                <TextView
                    android:id="@+id/tvRegionalTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Côn trùng quanh bạn"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="24dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRegionalInsects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:clipToPadding="false"
                    android:layout_marginTop="12dp"/>

                <!-- Cẩm nang & Tin tức -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Cẩm nang &amp; Tin tức"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>

                    <!-- Nút Thêm bài viết dành cho Admin -->
                    <ImageView
                        android:id="@+id/btnAddArticle"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:src="@android:drawable/ic_input_add"
                        app:tint="#2E7D32"
                        android:visibility="gone"
                        android:background="?attr/selectableItemBackgroundBorderless"/>
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvArticles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:clipToPadding="false"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>
        </ScrollView>

        <!-- ========================================== -->
        <!-- 2. MÀN HÌNH BẢN ĐỒ DỊCH HẠI                -->
        <!-- ========================================== -->
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Bản đồ Google Maps -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/mapFragment"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Dải màu đen mờ hiện tiêu đề Bản đồ ở phía trên -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌍 Bản đồ Dịch hại Cộng đồng"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#99000000"
                android:padding="12dp"
                android:gravity="center"
                android:layout_gravity="top" />
        </FrameLayout>

    </FrameLayout>

    <!-- THANH ĐIỀU HƯỚNG BÊN DƯỚI (Đã sửa lỗi fabCradleMargin) -->
    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:fabCradleMargin="8dp"
        app:fabAlignmentMode="center"
        app:backgroundTint="#FFFFFF"
        app:elevation="8dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:menu="@menu/bottom_nav_menu"
            app:itemTextColor="#2E7D32"
            app:itemIconTint="#2E7D32"/>
    </com.google.android.material.bottomappbar.BottomAppBar>

    <!-- Nút Camera chụp ảnh nằm trũng giữa thanh điều hướng -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_menu_camera"
        app:layout_anchor="@id/bottomAppBar"
        app:tint="#FFFFFF"
        app:backgroundTint="#2E7D32"
        app:maxImageSize="32dp"
        app:elevation="6dp"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChatAI"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="88dp"
        android:src="@android:drawable/sym_action_chat"
        app:tint="#FFFFFF"
        app:backgroundTint="#1976D2"
        app:elevation="6dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
