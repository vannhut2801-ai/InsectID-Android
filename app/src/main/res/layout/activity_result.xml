<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#2E7D32"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tvVietnameseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Tên Côn Trùng"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:src="@android:drawable/ic_menu_share"
                app:tint="#2E7D32"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </RelativeLayout>

        <ImageView
            android:id="@+id/ivResultImage"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Độ tin cậy: 0%"
                app:chipBackgroundColor="#E8F5E9"
                android:textColor="#2E7D32"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipInferenceTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thời gian: 0 ms"
                app:chipBackgroundColor="#E3F2FD"
                android:textColor="#1565C0" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvResultName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(Scientific Name)"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"
            android:textStyle="italic" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLifeStages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardNotebook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

        </androidx.cardview.widget.CardView>

        <include android:id="@+id/cardScientifit" layout="@layout/item_info_card" />
        <include android:id="@+id/cardMorphology" layout="@layout/item_info_card" />
        <include android:id="@+id/cardDistribution" layout="@layout/item_info_card" />
        <include android:id="@+id/cardImpact" layout="@layout/item_info_card" />
        <include android:id="@+id/cardMeasures" layout="@layout/item_info_card" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout4Stages"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <View android:id="@+id/centerPoint4"
                android:layout_width="1dp" android:layout_height="1dp"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VÒNG ĐỜI\n(4 GIAI ĐOẠN)"
                android:textAlignment="center"
                android:textSize="10sp"
                android:textColor="#BBBBBB"
                app:layout_constraintTop_toTopOf="@id/centerPoint4"
                app:layout_constraintBottom_toBottomOf="@id/centerPoint4"
                app:layout_constraintStart_toStartOf="@id/centerPoint4"
                app:layout_constraintEnd_toEndOf="@id/centerPoint4"/>

            <LinearLayout android:id="@+id/stage4_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"
                app:layout_constraintCircle="@id/centerPoint4" app:layout_constraintCircleRadius="95dp" app:layout_constraintCircleAngle="0"
                tools:ignore="MissingConstraints">
                <androidx.cardview.widget.CardView android:layout_width="64dp" android:layout_height="64dp" app:cardCornerRadius="32dp" app:cardElevation="4dp">
                    <ImageView android:id="@+id/img4_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="#E0E0E0"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tv4_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trứng" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/stage4_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"
                app:layout_constraintCircle="@id/centerPoint4" app:layout_constraintCircleRadius="95dp" app:layout_constraintCircleAngle="90"
                tools:ignore="MissingConstraints">
                <androidx.cardview.widget.CardView android:layout_width="64dp" android:layout_height="64dp" app:cardCornerRadius="32dp" app:cardElevation="4dp">
                    <ImageView android:id="@+id/img4_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="#E0E0E0"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tv4_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ấu trùng" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/stage4_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"
                app:layout_constraintCircle="@id/centerPoint4" app:layout_constraintCircleRadius="95dp" app:layout_constraintCircleAngle="180"
                tools:ignore="MissingConstraints">
                <androidx.cardview.widget.CardView android:layout_width="64dp" android:layout_height="64dp" app:cardCornerRadius="32dp" app:cardElevation="4dp">
                    <ImageView android:id="@+id/img4_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="#E0E0E0"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tv4_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nhộng" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/stage4_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"
                app:layout_constraintCircle="@id/centerPoint4" app:layout_constraintCircleRadius="95dp" app:layout_constraintCircleAngle="270"
                tools:ignore="MissingConstraints">
                <androidx.cardview.widget.CardView android:layout_width="64dp" android:layout_height="64dp" app:cardCornerRadius="32dp" app:cardElevation="4dp">
                    <ImageView android:id="@+id/img4_4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="#E0E0E0"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tv4_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trưởng thành" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>
            <ImageView
                android:layout_width="32dp" android:layout_height="32dp"
                android:src="@drawable/ic_arrow" app:tint="#2E7D32"
                app:layout_constraintCircle="@id/centerPoint4"
                app:layout_constraintCircleRadius="95dp"
                app:layout_constraintCircleAngle="45"
                android:rotation="45"
                tools:ignore="MissingConstraints"/>

            <ImageView
                android:layout_width="32dp" android:layout_height="32dp"
                android:src="@drawable/ic_arrow" app:tint="#2E7D32"
                app:layout_constraintCircle="@id/centerPoint4"
                app:layout_constraintCircleRadius="95dp"
                app:layout_constraintCircleAngle="135"
                android:rotation="135"
                tools:ignore="MissingConstraints"/>

            <ImageView
                android:layout_width="32dp" android:layout_height="32dp"
                android:src="@drawable/ic_arrow" app:tint="#2E7D32"
                app:layout_constraintCircle="@id/centerPoint4"
                app:layout_constraintCircleRadius="95dp"
                app:layout_constraintCircleAngle="225"
                android:rotation="225"
                tools:ignore="MissingConstraints"/>

            <ImageView
                android:layout_width="32dp" android:layout_height="32dp"
                android:src="@drawable/ic_arrow" app:tint="#2E7D32"
                app:layout_constraintCircle="@id/centerPoint4"
                app:layout_constraintCircleRadius="95dp"
                app:layout_constraintCircleAngle="315"
                android:rotation="315"
                tools:ignore="MissingConstraints"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout3Stages"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <View android:id="@+id/centerPoint3"
                android:layout_width="1dp" android:layout_height="1dp"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VÒNG ĐỜI\n(3 GIAI ĐOẠN)"
                android:textAlignment="center"
                android:textSize="10sp"
                android:textColor="#BBBBBB"
                app:layout_constraintTop_toTopOf="@id/centerPoint3"
                app:layout_constraintBottom_toBottomOf="@id/centerPoint3"
                app:layout_constraintStart_toStartOf="@id/centerPoint3"
                app:layout_constraintEnd_toEndOf="@id/centerPoint3"/>

            <LinearLayout android:id="@+id/stage3_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"
                app:layout_constraintCircle="@id/centerPoint3" app:layout_constraintCircleRadius="90dp" app:layout_constraintCircleAngle="0"
                tools:ignore="MissingConstraints">
                <androidx.cardview.widget.CardView android:layout_width="64dp" android:layout_height="64dp" app:cardCornerRadius="32dp" app:cardElevation="4dp">
                    <ImageView android:id="@+id/img3_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="#E0E0E0"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tv3_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trứng" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/stage3_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"
                app:layout_constraintCircle="@id/centerPoint3" app:layout_constraintCircleRadius="90dp" app:layout_constraintCircleAngle="120"
                tools:ignore="MissingConstraints">
                <androidx.cardview.widget.CardView android:layout_width="64dp" android:layout_height="64dp" app:cardCornerRadius="32dp" app:cardElevation="4dp">
                    <ImageView android:id="@+id/img3_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="#E0E0E0"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tv3_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sâu non" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/stage3_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center"
                app:layout_constraintCircle="@id/centerPoint3" app:layout_constraintCircleRadius="90dp" app:layout_constraintCircleAngle="240"
                tools:ignore="MissingConstraints">
                <androidx.cardview.widget.CardView android:layout_width="64dp" android:layout_height="64dp" app:cardCornerRadius="32dp" app:cardElevation="4dp">
                    <ImageView android:id="@+id/img3_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="#E0E0E0"/>
                </androidx.cardview.widget.CardView>
                <TextView android:id="@+id/tv3_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trưởng thành" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>
            <ImageView
                android:layout_width="32dp" android:layout_height="32dp"
                android:src="@drawable/ic_arrow" app:tint="#2E7D32"
                app:layout_constraintCircle="@id/centerPoint3"
                app:layout_constraintCircleRadius="90dp"
                app:layout_constraintCircleAngle="60"
                android:rotation="60"
                tools:ignore="MissingConstraints"/>

            <ImageView
                android:layout_width="32dp" android:layout_height="32dp"
                android:src="@drawable/ic_arrow" app:tint="#2E7D32"
                app:layout_constraintCircle="@id/centerPoint3"
                app:layout_constraintCircleRadius="90dp"
                app:layout_constraintCircleAngle="180"
                android:rotation="180"
                tools:ignore="MissingConstraints"/>

            <ImageView
                android:layout_width="32dp" android:layout_height="32dp"
                android:src="@drawable/ic_arrow" app:tint="#2E7D32"
                app:layout_constraintCircle="@id/centerPoint3"
                app:layout_constraintCircleRadius="90dp"
                app:layout_constraintCircleAngle="300"
                android:rotation="300"
                tools:ignore="MissingConstraints"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Sổ tay quan sát"
                android:textColor="#2E7D32"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLocation"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:endIconDrawable="@android:drawable/ic_menu_mylocation"
                app:endIconMode="custom"
                app:endIconTint="#1976D2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Địa điểm (Bấm icon để lấy tự động)"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="Ghi chú thêm (Số lượng, tình trạng...)"
                    android:inputType="textMultiLine"
                    android:lines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/cbContribute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:buttonTint="#2E7D32"
                android:checked="true"
                android:text="Chia sẻ vị trí phát hiện này lên Bản đồ Dịch hại để cảnh báo cho cộng đồng"
                android:textColor="#555555"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSaveNotebook"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#2E7D32"
                android:text="LƯU VÀO SỔ TAY"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#E8F5E9">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Kết quả này có chính xác không?"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnCorrect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#2E7D32"
                        android:text="Đúng vậy"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnWrong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#D32F2F"
                        android:text="Sai rồi"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutCorrection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etCorrectName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:hint="Theo bạn đây là con gì?"
                        android:padding="12dp"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnSubmitFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#1976D2"
                        android:text="Gửi dữ liệu huấn luyện"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>